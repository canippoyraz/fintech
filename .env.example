# Copy to .env and fill in. Only OPENROUTER_API_KEY is required.
#   cp .env.example .env

# Required: OpenRouter API key, used for the AI chat assistant.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in GBM market simulator (recommended).
MASSIVE_API_KEY=

# Optional: return deterministic mock LLM responses instead of calling
# OpenRouter. Used by the E2E tests; set to "true" to develop without a key.
LLM_MOCK=false

# Optional: SQLite file location, relative to the working directory.
# The container mounts its volume at /app/db, so the default lands there.
# FINTECH_DB_PATH=db/fintech.db

# Optional: directory holding the built frontend. Skipped if it doesn't exist.
# FINTECH_STATIC_DIR=static

# Optional: seconds between automatic portfolio value snapshots (P&L chart).
# FINTECH_SNAPSHOT_INTERVAL=30

# Optional: root log level (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO
